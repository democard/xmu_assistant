<?xml version="1.0" encoding="utf-8"?>
<!-- FileProvider 路径授权：仅暴露应用私有 files/images 与 cache/exports 两个子目录，
     前者供 Android 8.0-9（API<29）分享成绩长图使用，后者供课表 ICS 导出分享；
     其他目录一律不暴露，避免分享越权。 -->
<paths>
    <files-path name="shared_images" path="images/" />
    <cache-path name="exports" path="exports/" />
</paths>
